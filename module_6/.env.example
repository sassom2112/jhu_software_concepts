# The settings the stack and the code read.  Copy this file to module_6/.env (git-ignored)
# and replace every change-me.  Never commit real values.
#
#   * Docker Compose reads module_6/.env by itself: `docker compose up --build` in module_6/.
#   * For code run on this machine instead, load it into the shell:  source .env
#
# Passwords: Compose puts them into connection URLs (postgresql://user:PASSWORD@db/...,
# amqp://user:PASSWORD@rabbitmq/), so use only letters, digits, - and _ ; for example
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Only `export NAME=value` lines and comments: Compose can read nothing else.

# 1. The Docker Compose stack (docker-compose.yml)
#    PostgreSQL's administrator, gradcafe, owns the tables; only the one-shot init service
#    logs in as it (python -m worker.bootstrap).  PostgreSQL and RabbitMQ store these on
#    the first start, in their named volumes; to change one later, `docker compose down -v`
#    (which also deletes the data) and start again.
export POSTGRES_PASSWORD=change-me
#    RabbitMQ's user.  The management UI (http://localhost:15672) logs in with it too;
#    the guest/guest account is not created when these are set.
export RABBITMQ_DEFAULT_USER=gradcafe
export RABBITMQ_DEFAULT_PASS=change-me
#    Host ports, bound to 127.0.0.1 only.  PostgreSQL is not published at all.
export WEB_PORT=8080
export RABBITMQ_UI_PORT=15672

# 2. The two least-privilege database roles (src/db/db_roles.py).  The init service
#    creates or resets them with these passwords on every start: the web app logs in as
#    WEB_DB_USER (SELECT only) and the worker as WORKER_DB_USER (SELECT, INSERT and its
#    bookkeeping UPSERTs).
export WEB_DB_USER=gradcafe_web
export WEB_DB_PASSWORD=change-me
export WORKER_DB_USER=gradcafe_worker
export WORKER_DB_PASSWORD=change-me

# 3. Code run on this machine, outside Docker.  Precedence (src/db/db_config.py):
#    DATABASE_URL > DB_* > PGHOST/PGPORT/PGUSER/PGDATABASE > defaults.
#    A web app on this machine logs in as the web role (DB_PASSWORD = WEB_DB_PASSWORD):
export DB_HOST=localhost
export DB_PORT=5432
export DB_NAME=gradcafe
export DB_USER=gradcafe_web
export DB_PASSWORD=change-me
#    DATABASE_URL would win over every DB_* setting, so it is not set here (run
#    `unset DATABASE_URL` if your shell has one).  Give it to the one command that needs
#    the table owner, whose password stays in ~/.pgpass (chmod 600) as
#    localhost:5432:*:gradcafe:YOUR_PASSWORD, never in this file:
#      DATABASE_URL=postgresql://gradcafe@localhost:5432/gradcafe python -m worker.bootstrap
#    (creates the tables and both roles, loads src/data/applicant_data.json and computes
#    the first analysis snapshot), or just the roles:
#      DATABASE_URL=postgresql://gradcafe@localhost:5432/gradcafe gradcafe-roles
#
#    RabbitMQ for code on this machine (the stack does not publish port 5672; Compose
#    gives its services their own RABBITMQ_URL):
# export RABBITMQ_URL=amqp://gradcafe:change-me@localhost:5672/
#    The worker's scraper keeps its files here (default: a folder in the temp directory):
# export SCRAPE_DATA_DIR=/tmp/gradcafe_scrape
#    The web page (src/web/run.py):
# export FLASK_SECRET_KEY=change-me
# export FLASK_HOST=127.0.0.1
# export PORT=8080
# export FLASK_DEBUG=1        # development machines only

# 4. Tests: point DATABASE_URL at a throwaway database whose name ends in _test (the
#    tests ignore every DB_*, WEB_DB_*, WORKER_DB_*, RABBITMQ_URL and SCRAPE_DATA_DIR
#    setting above), e.g.
# DATABASE_URL=postgresql://gradcafe@localhost:5432/gradcafe_test python -m pytest module_6
