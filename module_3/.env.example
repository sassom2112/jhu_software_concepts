# Copy these into your shell (or a git-ignored .env that you source); never commit real values.
# Password: put it in ~/.pgpass (chmod 600) as  localhost:5432:*:gradcafe:YOUR_PASSWORD
# or export PGPASSWORD for the current shell only.
DATABASE_URL=postgresql://gradcafe@localhost:5432/gradcafe
# Alternatively, the standard libpq variables:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=gradcafe
# PGDATABASE=gradcafe
# Optional:
# FLASK_SECRET_KEY=change-me
# PORT=8080
