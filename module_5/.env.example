# The environment variables the code reads. Copy to a git-ignored .env and `source .env`,
# or paste into your shell; never commit real values.
# Password: put it in ~/.pgpass (chmod 600) as  localhost:5432:*:gradcafe:YOUR_PASSWORD
# or export PGPASSWORD for the current shell only.
export DATABASE_URL=postgresql://gradcafe@localhost:5432/gradcafe
# Alternatively, the standard libpq variables (used when DATABASE_URL is unset):
# export PGHOST=localhost
# export PGPORT=5432
# export PGUSER=gradcafe
# export PGDATABASE=gradcafe
# Optional, for the web page (src/run.py):
# export FLASK_SECRET_KEY=change-me
# export FLASK_HOST=127.0.0.1
# export PORT=8080
# export FLASK_DEBUG=1        # development machines only
# Tests: point DATABASE_URL at a throwaway database whose name ends in _test, e.g.
# DATABASE_URL=postgresql://gradcafe@localhost:5432/gradcafe_test
