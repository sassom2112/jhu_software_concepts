# The environment variables the code reads.  Copy to a git-ignored .env, replace every
# change-me, and `source .env` (or paste into your shell).  Never commit real values.
# Precedence (see src/db_config.py): DATABASE_URL > DB_* > PGHOST/PGPORT/PGUSER/PGDATABASE > defaults.

# 1. The web app (src/run.py) logs in as the least-privilege role gradcafe_app:
#    SELECT and INSERT on applicants, nothing else (src/db_roles.py creates it).
export DB_HOST=localhost
export DB_PORT=5432
export DB_NAME=gradcafe
export DB_USER=gradcafe_app
export DB_PASSWORD=change-me
# DATABASE_URL would win over every DB_* setting, so it is not left set in this shell;
# give it to the one command that needs the owner (step 2).
unset DATABASE_URL

# 2. Administrator commands connect as the table owner, gradcafe, through DATABASE_URL.
#    Its password stays in ~/.pgpass (chmod 600) as  localhost:5432:*:gradcafe:YOUR_PASSWORD
#    (or PGPASSWORD for one shell), never in this file.  Prefix the command:
#      DATABASE_URL=postgresql://gradcafe@localhost:5432/gradcafe python src/load_data.py
#      DATABASE_URL=postgresql://gradcafe@localhost:5432/gradcafe python src/db_roles.py

# 3. Provisioning (src/db_roles.py) creates or resets this role with this password;
#    use the same values as DB_USER and DB_PASSWORD above.
export APP_DB_USER=gradcafe_app
export APP_DB_PASSWORD=change-me

# Optional, for the web page (src/run.py):
# export FLASK_SECRET_KEY=change-me
# export FLASK_HOST=127.0.0.1
# export PORT=8080
# export FLASK_DEBUG=1        # development machines only

# 4. Tests: point DATABASE_URL at a throwaway database whose name ends in _test (the
#    tests ignore every DB_* and APP_DB_* setting above), e.g.
# DATABASE_URL=postgresql://gradcafe@localhost:5432/gradcafe_test python -m pytest module_5
