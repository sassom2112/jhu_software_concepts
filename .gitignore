.vscode/

# pytest / pytest-cov artifacts: each module's tests run from the repository root (its
# pytest.ini measures module_N/src), so pytest-cov's .coverage lands here; .pytest_cache
# goes to the module folder (pytest's rootdir, where pytest.ini lives).  Ignored anywhere.
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# --------------------------------------------------------------------------------------
# Module 6.  These rules used to live in module_6/.gitignore; repository-level files now
# live at the root.  Patterns with a slash are anchored to module_6/, the rest apply
# anywhere in the repository (modules 1-5 keep their own .gitignore files as submitted).
# --------------------------------------------------------------------------------------

# virtual environments and Python caches
.venv/
venv/
env/
__pycache__/
*.pyc

# secrets: module_6/.env holds the real passwords (Docker Compose reads it); only the
# placeholder file .env.example is committed
.env
.env.*
!.env.example

# packaging output of `pip install -e .` / `python -m build`.  build/ is anchored to
# module_6/ on purpose: a bare build/ would also hide docs/build/html, which is committed.
*.egg-info/
/module_6/build/
/module_6/dist/

# Sphinx build output (docs/build/html is committed as the deliverable; intermediates are not)
/module_6/docs/build/doctrees/
/module_6/docs/build/html/.doctrees/

# runtime data of the command-line scraper (same as module_2/module_3)
/module_6/data/raw_html/
/module_6/data/*.jsonl
/module_6/data/*.tmp
/module_6/data/*.log
/module_6/data/*.pid
/module_6/data/checkpoint.json
/module_6/data/raw_entries.json

# --------------------------------------------------------------------------------------
# Module 7.  Downloads and keys that must never be committed (.env is ignored above).
# --------------------------------------------------------------------------------------

# the notebook's output (36 MB), its temporary .part file, and a local copy of the S3 object
/module_7/applicant_data_SM.json
/module_7/applicant_data_SM.json.part
/module_7/applicant_data.json
# Jupyter's autosave folder
.ipynb_checkpoints/
# EC2 key pairs and the CSV files the IAM console downloads (access keys, passwords)
*.pem
*.ppk
*accessKeys.csv
*credentials.csv
# an EC2 deploy folder made inside the repository by mistake (EC2_DEPLOYMENT.md uses ~/gradcafe-ec2)
/module_7/ec2/data/
