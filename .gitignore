.vscode/

# pytest / pytest-cov artifacts: pytest runs from the repo root (module_4/pytest.ini's
# --cov=module_4/src path), so pytest-cov's .coverage lands here; .pytest_cache goes to
# module_4/ (pytest's rootdir, where pytest.ini lives) and is ignored there too.
.pytest_cache/
.coverage
.coverage.*
htmlcov/
