# Settings for docker-compose.ec2.yml.  Copy this file to .env in the deploy folder,
# replace every change-me, and copy .env to the server next to docker-compose.ec2.yml
# (EC2_DEPLOYMENT.md, steps 6 and 7).  Never commit the real .env.
#
# Passwords go into connection URLs (postgresql://user:PASSWORD@db/...,
# amqp://user:PASSWORD@rabbitmq/), so use only letters, digits, - and _ .  This prints
# a suitable one:  openssl rand -hex 24
# PostgreSQL and RabbitMQ store their passwords on the first start, in their volumes.
# To change one later: docker compose -f docker-compose.ec2.yml down -v (this deletes
# the database), then up -d again; init loads the data again.

# PostgreSQL's administrator, gradcafe, owns the tables; only the one-shot init service
# logs in as it.
POSTGRES_PASSWORD=change-me

# RabbitMQ's user, also the login for the management UI (through the SSH tunnel).
RABBITMQ_DEFAULT_USER=gradcafe
RABBITMQ_DEFAULT_PASS=change-me

# The two least-privilege database roles; init creates them (or resets their passwords)
# on every start.  The web app logs in as WEB_DB_USER (SELECT only), the worker as
# WORKER_DB_USER (SELECT, INSERT and its bookkeeping UPSERTs).
WEB_DB_USER=gradcafe_web
WEB_DB_PASSWORD=change-me
WORKER_DB_USER=gradcafe_worker
WORKER_DB_PASSWORD=change-me

# Ports on the server.  WEB_PORT is published on all interfaces (the security group
# limits who can reach it); RABBITMQ_UI_PORT only on the server's 127.0.0.1.
WEB_PORT=8080
RABBITMQ_UI_PORT=15672
